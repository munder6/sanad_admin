# Sanad Admin — build-time environment variables.
#
# These are NEXT_PUBLIC_* vars, so Next.js INLINES them into the static export at
# `next build` time (they are frozen into the JS bundle — changing them requires a
# rebuild). See node_modules/next/dist/docs/01-app/02-guides/environment-variables.md
#
# For local development: copy this file to `.env.local` and adjust.
# For staging/production: the values are injected by CI
# (.github/workflows/deploy-admin-staging.yml and deploy-admin-production.yml).
# Process env (CI) takes precedence over any .env file, so CI always wins.
#
# Real .env* files are gitignored (only *.example files are committed).

# Base URL of the Sanad API (no trailing slash).
#   local dev  : http://localhost/sanad_api/public/api
#   staging    : https://wewill.tech/sanad-api/api-staging/api
#   production : https://wewill.tech/sanad-api/api
NEXT_PUBLIC_API_BASE_URL=http://localhost/sanad_api/public/api

# Sub-path the app is served under. Inlined into asset (`_next`) and link paths.
# No trailing slash. Leave empty for local dev (served at the domain root).
#   local dev  : (empty)
#   staging    : /sanad-admin-staging
#   production : /sanad-admin
NEXT_PUBLIC_BASE_PATH=
